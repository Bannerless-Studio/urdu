{"units":[{"id":"ur-alif","st":"abjad","set":1,"group":"alif","t":"ا","name":"alif","roman":"ā","alt":["a"],"say":"ا","note":"ā as in 'father'; also carries a word-initial short vowel","confuse":["ur-alif-madd","ur-lam"],"ex":[["w0027","apnā"],["w0042","ab"],["w0288","andar"]],"joins":"right"},{"id":"ur-be","st":"abjad","set":1,"group":"be","t":"ب","name":"be","roman":"b","say":"بَ","note":"b","confuse":["ur-pe","ur-te","ur-tte","ur-nun"],"ex":[["w0064","bāt"],["w0069","banānā"],["w0092","bannā"]],"joins":"dual"},{"id":"ur-pe","st":"abjad","set":1,"group":"be","t":"پ","name":"pe","roman":"p","say":"پَ","note":"p","confuse":["ur-be","ur-te","ur-tte"],"ex":[["w0014","par"],["w0302","pānā"],["w0453","purānā"]],"joins":"dual"},{"id":"ur-te","st":"abjad","set":1,"group":"be","t":"ت","name":"te","roman":"t","say":"تَ","note":"soft dental t (tongue on the teeth)","confuse":["ur-be","ur-pe","ur-tte","ur-se"],"ex":[["w0030","tum"],["w0082","tamām"],["w0490","tab"]],"joins":"dual"},{"id":"ur-tte","st":"abjad","set":1,"group":"be","t":"ٹ","name":"ṭe","roman":"ṭ","say":"ٹَ","note":"hard retroflex ṭ (tongue curled back)","confuse":["ur-te","ur-be","ur-pe"],"ex":[["w0312","minaṭ"]],"joins":"dual"},{"id":"ur-nun","st":"abjad","set":1,"group":"be","t":"ن","name":"nūn","roman":"n","say":"نَ","note":"n","confuse":["ur-be","ur-te","ur-nun-ghunna"],"ex":[["w0079","nām"],["w0224","nambar"],["w0240","nā"]],"joins":"dual"},{"id":"ur-dal","st":"abjad","set":1,"group":"dal","t":"د","name":"dāl","roman":"d","say":"دَ","note":"soft dental d","confuse":["ur-ddal","ur-zal","ur-re"],"ex":[["w0086","din"],["w0288","andar"],["w0250","madad"]],"joins":"right"},{"id":"ur-re","st":"abjad","set":1,"group":"re","t":"ر","name":"re","roman":"r","say":"رَ","note":"r (tapped)","confuse":["ur-rre","ur-ze","ur-dal"],"ex":[["w0148","rāt"],["w0014","par"],["w0110","bār"]],"joins":"right"},{"id":"ur-mim","st":"abjad","set":1,"group":"mim","t":"م","name":"mīm","roman":"m","say":"مَ","note":"m","confuse":["ur-choti-he"],"ex":[["w1301","mārnā"],["w0299","mat"],["w0250","madad"]],"joins":"dual"},{"id":"ur-choti-ye","st":"abjad","set":2,"group":"ye","t":"ی","name":"choṭī ye","roman":"y","alt":["ī","i"],"say":"ی","note":"y; also the vowel ī","confuse":["ur-bari-ye","ur-nun"],"ex":[["w0018","ye"],["w0050","yā"],["w0140","yahī"]],"joins":"dual"},{"id":"ur-bari-ye","st":"abjad","set":2,"group":"ye","t":"ے","name":"baṛī ye","roman":"e","alt":["ai"],"say":"ے","note":"the vowels e / ai; only at the end of a word","confuse":["ur-choti-ye"],"ex":[["w0013","ne"],["w0126","pahle"],["w0277","āge"]],"joins":"right"},{"id":"ur-vao","st":"abjad","set":2,"group":"vao","t":"و","name":"vāʾo","roman":"v","alt":["ū","o","au"],"say":"و","note":"v; also the vowels ū, o, au","confuse":["ur-dal","ur-re"],"ex":[["w0003","vo"],["w0038","vālā"],["w0255","vālid"]],"joins":"right"},{"id":"ur-choti-he","st":"abjad","set":2,"group":"he","t":"ہ","name":"choṭī he","roman":"h","alt":["a"],"say":"ہَ","note":"h; a at the end of a word (کمرہ kamra)","confuse":["ur-do-chashmi-he","ur-mim"],"ex":[["w0002","honā"],["w0024","ham"],["w0036","hī"]],"joins":"dual"},{"id":"ur-kaf","st":"abjad","set":2,"group":"kaf","t":"ک","name":"kāf","roman":"k","say":"کَ","note":"k","confuse":["ur-gaf","ur-lam"],"ex":[["w0001","kā"],["w0010","ko"],["w0008","karnā"]],"joins":"dual"},{"id":"ur-gaf","st":"abjad","set":2,"group":"kaf","t":"گ","name":"gāf","roman":"g","say":"گَ","note":"g as in 'go'","confuse":["ur-kaf"],"ex":[["w0270","gunā"],["w0563","gānā"],["w0398","golī"]],"joins":"dual"},{"id":"ur-lam","st":"abjad","set":2,"group":"lam","t":"ل","name":"lām","roman":"l","say":"لَ","note":"l","confuse":["ur-alif","ur-kaf"],"ex":[["w0040","lenā"],["w0045","log"],["w0046","lekin"]],"joins":"dual"},{"id":"ur-alif-madd","st":"abjad","set":2,"group":"alif","t":"آ","name":"alif madd","roman":"ā","alt":["a"],"say":"آ","note":"ā at the start of a word","confuse":["ur-alif"],"ex":[["w0015","āp"],["w0029","ānā"],["w0165","ādmī"]],"joins":"right"},{"id":"ur-jim","st":"abjad","set":3,"group":"jim","t":"ج","name":"jīm","roman":"j","say":"جَ","note":"j","confuse":["ur-ce","ur-bari-he","ur-khe"],"ex":[["w0021","jānā"],["w0026","jo"],["w0057","jab"]],"joins":"dual"},{"id":"ur-ce","st":"abjad","set":3,"group":"jim","t":"چ","name":"ce","roman":"c","alt":["ch"],"say":"چَ","note":"ch as in 'church'","confuse":["ur-jim","ur-bari-he","ur-khe"],"ex":[["w0062","cāhnā"],["w0074","calnā"],["w0081","cāhiye"]],"joins":"dual"},{"id":"ur-bari-he","st":"abjad","set":3,"group":"jim","t":"ح","name":"baṛī he","roman":"h","say":"حَ","note":"h (Arabic loanwords)","confuse":["ur-jim","ur-ce","ur-khe","ur-choti-he"],"ex":[["w0122","hukūmat"],["w0129","hamla"],["w0340","hukm"]],"joins":"dual"},{"id":"ur-khe","st":"abjad","set":3,"group":"jim","t":"خ","name":"xe","roman":"x","alt":["kh"],"say":"خَ","note":"ch as in Scottish 'loch'","confuse":["ur-jim","ur-ce","ur-bari-he"],"ex":[["w0108","xud"],["w0183","xayāl"],["w0272","xāndān"]],"joins":"dual"},{"id":"ur-sin","st":"abjad","set":3,"group":"sin","t":"س","name":"sīn","roman":"s","say":"سَ","note":"s","confuse":["ur-shin","ur-svad","ur-se"],"ex":[["w0006","se"],["w0037","sab"],["w0049","saknā"]],"joins":"dual"},{"id":"ur-shin","st":"abjad","set":3,"group":"sin","t":"ش","name":"śīn","roman":"ś","alt":["sh"],"say":"شَ","note":"sh","confuse":["ur-sin","ur-svad"],"ex":[["w0131","śahr"],["w0226","śāyad"],["w0324","śukriya"]],"joins":"dual"},{"id":"ur-ddal","st":"abjad","set":4,"group":"dal","t":"ڈ","name":"ḍāl","roman":"ḍ","say":"ڈَ","note":"hard retroflex ḍ","confuse":["ur-dal","ur-zal"],"ex":[["w0151","ḍālnā"],["w0168","ḍākṭar"]],"joins":"right"},{"id":"ur-rre","st":"abjad","set":4,"group":"re","t":"ڑ","name":"ṛe","roman":"ṛ","say":"ڑَ","note":"retroflex flap ṛ (never starts a word)","confuse":["ur-re","ur-ze"],"ex":[["w0068","baṛā"],["w0103","paṛnā"],["w0232","laṛkī"]],"joins":"right"},{"id":"ur-zal","st":"abjad","set":4,"group":"dal","t":"ذ","name":"zāl","roman":"z","say":"ذَ","note":"z (Arabic loanwords)","confuse":["ur-dal","ur-ddal","ur-ze","ur-zvad","ur-zoe"],"ex":[["w0753","zātī"],["w0902","zarā"],["w1117","zihn"]],"joins":"right"},{"id":"ur-ze","st":"abjad","set":4,"group":"re","t":"ز","name":"ze","roman":"z","say":"زَ","note":"z","confuse":["ur-re","ur-rre","ur-zhe","ur-zal"],"ex":[["w0058","zyāda"],["w0109","zindagī"],["w0221","zamīn"]],"joins":"right"},{"id":"ur-zhe","st":"abjad","set":4,"group":"re","t":"ژ","name":"že","roman":"ž","alt":["zh"],"say":"ژَ","note":"s as in 'pleasure'; rare, in Persian and English loanwords: ٹیلی ویژن ṭelīvižan (television), ژالہ žāla (hail)","confuse":["ur-ze","ur-re"],"joins":"right"},{"id":"ur-nun-ghunna","st":"abjad","set":4,"group":"be","t":"ں","name":"nūn ġunna","roman":"̃","say":"ں","note":"no n sound: the vowel before it is nasal (میں mẽ); only at the end of a word","confuse":["ur-nun"],"ex":[["w0004","mẽ"],["w0011","nahī̃"],["w0060","yahā̃"]],"joins":"right"},{"id":"ur-do-chashmi-he","st":"abjad","set":5,"group":"he","t":"ھ","name":"do-caśmī he","roman":"h","say":"ھ","note":"breathy h after a consonant: بھ bh, پھ ph, تھ th, کھ kh, گھ gh, چھ ch","confuse":["ur-choti-he"],"ex":[["w0019","bhī"],["w0033","kuch"],["w0039","dekhnā"]],"joins":"dual"},{"id":"ur-se","st":"abjad","set":5,"group":"be","t":"ث","name":"se","roman":"s","say":"ثَ","note":"s (Arabic loanwords)","confuse":["ur-te","ur-be","ur-sin","ur-svad"],"ex":[["w0252","sābit"]],"joins":"dual"},{"id":"ur-svad","st":"abjad","set":5,"group":"svad","t":"ص","name":"svād","roman":"s","say":"صَ","note":"s (Arabic loanwords)","confuse":["ur-zvad","ur-sin","ur-se"],"ex":[["w0095","sāhib"],["w0219","sahīh"],["w0319","sadr"]],"joins":"dual"},{"id":"ur-zvad","st":"abjad","set":5,"group":"svad","t":"ض","name":"zvād","roman":"z","say":"ضَ","note":"z (Arabic loanwords)","confuse":["ur-svad","ur-ze","ur-zal","ur-zoe"],"ex":[["w0202","zarūrī"],["w0419","zurūr"],["w0412","vāzih"]],"joins":"dual"},{"id":"ur-toe","st":"abjad","set":6,"group":"toe","t":"ط","name":"to'e","roman":"t","say":"طَ","note":"t (Arabic loanwords)","confuse":["ur-zoe","ur-te"],"ex":[["w0061","taur"],["w0075","tarh"],["w0229","matlab"]],"joins":"dual"},{"id":"ur-zoe","st":"abjad","set":6,"group":"toe","t":"ظ","name":"zo'e","roman":"z","say":"ظَ","note":"z (Arabic loanwords)","confuse":["ur-toe","ur-ze","ur-zal","ur-zvad"],"ex":[["w0184","nizām"],["w0290","nazar"],["w0352","ʿazīm"]],"joins":"dual"},{"id":"ur-ain","st":"abjad","set":6,"group":"ain","t":"ع","name":"ʿain","roman":"ʿ","say":"عَ","note":"usually silent in Urdu, or it lengthens the vowel next to it; shown as ʿ in the pron","confuse":["ur-ghain","ur-bari-he"],"ex":[["w0207","ʿaurat"],["w0217","ʿām"],["w0265","ʿamal"]],"joins":"dual"},{"id":"ur-ghain","st":"abjad","set":6,"group":"ain","t":"غ","name":"ġain","roman":"ġ","alt":["gh"],"say":"غَ","note":"a throaty g, like French r","confuse":["ur-ain","ur-qaf"],"ex":[["w0204","ġair"],["w0307","ġalat"],["w0373","baġair"]],"joins":"dual"},{"id":"ur-fe","st":"abjad","set":7,"group":"fe","t":"ف","name":"fe","roman":"f","say":"فَ","note":"f","confuse":["ur-qaf","ur-ghain"],"ex":[["w0199","fauj"],["w0286","farmānā"],["w0344","faisla"]],"joins":"dual"},{"id":"ur-qaf","st":"abjad","set":7,"group":"fe","t":"ق","name":"qāf","roman":"q","say":"قَ","note":"a k from deep in the throat","confuse":["ur-fe","ur-kaf"],"ex":[["w0194","qism"],["w0225","qābil"],["w0263","qānūn"]],"joins":"dual"},{"id":"ur-hamza","st":"abjad","set":8,"group":"hamza","t":"ئ","name":"hamza","roman":"ʾ","say":"ئ","note":"hamza on a ye seat: a vowel break between two vowels (کوئی koī, بھائی bhāī)","confuse":["ur-choti-ye","ur-ain"],"ex":[["w0023","koī"],["w0180","masʾala"],["w0193","bhāī"]],"joins":"dual"}],"notes":[{"st":"abjad","set":1,"h":"Right to left, short vowels unwritten","body":"Urdu is read from right to left in the Nastaliq style. Only long vowels are letters: ā (ا), ū/o (و), ī/e (ی ے). The short vowels a, i, u are not written, so کم is kam."},{"st":"abjad","set":1,"h":"Joining","body":"Most letters join on both sides and change shape. These never join the letter after them: ا آ د ڈ ذ ر ڑ ز ژ و ے."},{"st":"abjad","set":1,"h":"Dental and retroflex","body":"ت د are soft (tongue on the teeth); ٹ ڈ ڑ, with the small ط on top, are hard (tongue curled back). The pron marks the hard ones with a dot: ṭ ḍ ṛ."},{"st":"abjad","set":2,"h":"Lam-alif ligature","body":"ل followed by ا is not written as two joined shapes: they fuse into one sign, لا. Read it as lā: لانا lānā, لال lāl, بلانا bulānā."},{"st":"abjad","set":2,"h":"Two ye, two he","body":"ی (choṭī ye) is y or ī; ے (baṛī ye) is e or ai and only ends a word. ہ (choṭī he) is h, or the vowel a at the end of a word."},{"st":"abjad","set":4,"h":"Nasal ں","body":"ں has no dot and no n sound: it makes the vowel before it nasal (میں mẽ, نہیں nahī̃)."},{"st":"abjad","set":5,"h":"Aspirates with ھ","body":"ھ (do-caśmī he) adds a breath to the letter before it and counts as part of that sound: بھائی bhāī, کھانا khānā, تھا thā."},{"st":"abjad","set":5,"h":"One sound, several letters","body":"Arabic loanwords keep their spelling: s is س ص ث, z is ز ذ ض ظ, t is ت ط, h is ہ ح. Learn which letter each word uses."},{"st":"abjad","set":8,"h":"Hamza on vao: ؤ","body":"ؤ is vao carrying a small hamza. It marks a vowel break before the o/ū it spells, mostly in verb forms: جاؤ jāo, آؤ āo, بتاؤ batāo, کھاؤ khāo. Read it as و."},{"st":"abjad","set":8,"h":"Khaṛī zabar: ٰ","body":"ٰ (khaṛī zabar, a small upright alif above a letter) is the vowel ā in a few Arabic words, often over ی or ہ: اعلیٰ aʿlā, لہٰذا lihāzā, دعویٰ daʿvā. It is often left out: لہذا."}]}
